rules_version = '2';
// The app never reads or writes the database directly. Every request goes through the
// PhysiQuest server functions, which check who is asking and validate every field.
// So nobody, signed in or not, can touch the database from outside.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
