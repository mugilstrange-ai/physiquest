rules_version = '2';
// PhysiQuest database rules.
// The app talks to the database directly, so these rules ARE the security:
//  - a student can only read and change their own details, progress and payment requests;
//  - a payment request is just a request: it cannot switch Premium on;
//  - only the owner's Google account can approve a payment and grant Premium;
//  - a student may have at most 3 payment requests waiting, sent at least a minute apart;
//  - Premium can only be written in the same step as approving a waiting payment from that student;
//  - the weekly leaderboard holds only a nickname and weekly XP, and each student writes only their own row;
//  - Razorpay payments are written only by the PhysiQuest payment server (worker/physiquest-pay.js), which uses
//    Google admin access after Razorpay confirms the payment; the app can only read a student's own records.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'mugilstrange@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function text(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function mobile(v) { return v is string && v.matches('^[6-9][0-9]{9}$'); }

    // ---------- a student's details (only what the app needs) ----------
    match /users/{uid} {
      allow read: if isMe(uid) || isOwner();
      allow create, update: if isMe(uid) && validProfile(request.resource.data);
      allow delete: if isMe(uid);
    }
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'cls', 'city', 'state', 'phone', 'adult', 'parentName', 'parentPhone', 'parentOk', 'email', 'v', 'at'])
        && d.keys().hasAll(['name', 'cls', 'city', 'state', 'phone', 'adult', 'email', 'v', 'at'])
        && text(d.name, 2, 60)
        && d.cls in ['6', '7', '8', '9', '10', '11', '12', 'dropper', 'college', 'other']
        && text(d.city, 2, 50)
        && d.state in ['Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chhattisgarh', 'Goa', 'Gujarat', 'Haryana', 'Himachal Pradesh', 'Jharkhand', 'Karnataka', 'Kerala', 'Madhya Pradesh', 'Maharashtra', 'Manipur', 'Meghalaya', 'Mizoram', 'Nagaland', 'Odisha', 'Punjab', 'Rajasthan', 'Sikkim', 'Tamil Nadu', 'Telangana', 'Tripura', 'Uttar Pradesh', 'Uttarakhand', 'West Bengal', 'Andaman and Nicobar Islands', 'Chandigarh', 'Dadra and Nagar Haveli and Daman and Diu', 'Delhi', 'Jammu and Kashmir', 'Ladakh', 'Lakshadweep', 'Puducherry']
        && (d.phone == '' || mobile(d.phone))
        && d.adult is bool
        && d.email == request.auth.token.email
        && d.v == 1 && d.at is timestamp
        && ((d.adult == true && !d.keys().hasAny(['parentName', 'parentPhone', 'parentOk']))
          || (d.adult == false && text(d.parentName, 2, 60) && mobile(d.parentPhone)
              && d.parentOk == true && d.parentPhone != d.phone));
    }

    // ---------- saved progress ----------
    match /progress/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && text(request.resource.data.code, 4, 200000)
        && request.resource.data.at is timestamp;
    }

    // ---------- payment requests: one per UPI transaction ID (UTR), so a UTR can only be used once ----------
    match /payments/{utr} {
      // written together with the student's queue counter (payq), which limits waiting requests
      allow create: if signedIn() && utr.matches('^[0-9]{12}$')
        && validPayment(request.resource.data, utr)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/payq/$(request.auth.uid)).data.last == utr
        && getAfter(/databases/$(database)/documents/payq/$(request.auth.uid)).data.at == request.time;
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      // decided once, by the owner: waiting -> approved or not approved
      allow update: if isOwner() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'exp', 'note'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    // ---------- each student's payment queue: how many requests are waiting, and when the last one was sent ----------
    match /payq/{uid} {
      allow read: if isMe(uid) || isOwner();
      allow create: if isMe(uid) && queued(uid, 0);
      allow update: if (isMe(uid) && queued(uid, resource.data.open)
                        && request.time > resource.data.at + duration.value(1, 'm'))
        || (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open'])
                        && request.resource.data.open == resource.data.open - 1 && request.resource.data.open >= 0);
      allow delete: if false;
    }
    function queued(uid, before) {
      return request.resource.data.keys().hasOnly(['open', 'last', 'at'])
        && request.resource.data.keys().hasAll(['open', 'last', 'at'])
        && request.resource.data.open == before + 1 && request.resource.data.open <= 3
        && request.resource.data.at == request.time
        && request.resource.data.last is string && request.resource.data.last.matches('^[0-9]{12}$')
        && !exists(/databases/$(database)/documents/payments/$(request.resource.data.last))
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.last)).data.uid == uid;
    }
    function validPayment(d, utr) {
      return d.keys().hasOnly(['uid', 'plan', 'amount', 'utr', 'status', 'at', 'name', 'email'])
        && d.keys().hasAll(['uid', 'plan', 'amount', 'utr', 'status', 'at', 'name', 'email'])
        && d.uid == request.auth.uid && d.utr == utr && d.status == 'pending'
        && ((d.plan == 'M' && d.amount == 99) || (d.plan == 'Y' && d.amount == 899))
        && text(d.name, 2, 60) && d.email == request.auth.token.email && d.at is timestamp;
    }

    // ---------- Premium: only the owner can grant, change or remove it ----------
    match /premium/{uid} {
      allow read: if isMe(uid) || isOwner();
      // only together with approving a waiting payment from this student, for the same plan
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['plan', 'exp', 'utr', 'at'])
        && request.resource.data.keys().hasAll(['plan', 'exp', 'utr', 'at'])
        && request.resource.data.plan in ['M', 'Y']
        && request.resource.data.exp is int && request.resource.data.exp >= 0 && request.resource.data.exp < 5000
        && request.resource.data.at is timestamp
        && request.resource.data.utr is string && request.resource.data.utr.matches('^[0-9]{12}$')
        && get(/databases/$(database)/documents/payments/$(request.resource.data.utr)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.utr)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.utr)).data.uid == uid
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.utr)).data.plan == request.resource.data.plan;
      allow delete: if isOwner();   // after a refund
    }

    // ---------- weekly leaderboard: a nickname and this week's XP, nothing else ----------
    // any signed-in student may read the board; each student writes only their own row;
    // the owner may remove a row (for example an unsuitable nickname)
    match /board/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && validBoard(request.resource.data);
      allow delete: if isMe(uid) || isOwner();
    }
    function validBoard(d) {
      return d.keys().hasOnly(['nick', 'xp', 'week', 'cls', 'at'])
        && d.keys().hasAll(['nick', 'xp', 'week', 'cls', 'at'])
        && d.nick is string && d.nick.matches('^[A-Za-z0-9 _.-]{2,20}$')
        && d.xp is int && d.xp >= 0 && d.xp <= 20000
        && d.week is int && d.week >= 2900 && d.week <= 5000
        && d.cls is string && d.cls.size() <= 3
        && d.at is timestamp;
    }

    // ---------- Razorpay payments (gwpay/{payment link id}): written only by the payment server ----------
    // The server writes the payment record and Premium together, with admin access that these rules do not limit.
    // Students read only their own records (for receipts); nobody can write them from the app.
    match /gwpay/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ---------- app settings, such as the payment server's address: read by the app, changed only in the Firebase console ----------
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
